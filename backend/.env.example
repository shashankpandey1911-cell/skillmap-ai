# ============================================================
# SkillMap AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Django Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Render sets DATABASE_URL automatically when you add a PostgreSQL service.
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Local dev fallback: leave DATABASE_URL unset to use SQLite,
# or set DB_ENGINE=postgres with manual env vars.
# DB_ENGINE=postgres
# DB_NAME=skillmap
# DB_USER=skillmap
# DB_PASSWORD=skillmap
# DB_HOST=localhost
# DB_PORT=5432

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Frontend URL ---
# Password-reset / email-verification links point at the SPA
FRONTEND_URL=http://localhost:5173

# --- Email Verification ---
EMAIL_VERIFICATION_TOKEN_HOURS=24
# Require new sign-ups to confirm their email before logging in (true/false)
EMAIL_VERIFICATION_REQUIRED=true

# --- SMTP (used whenever EMAIL_HOST is set, dev or production). Never commit real credentials. ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=app-specific-password
# EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=SkillMap AI <no-reply@example.com>

# --- Optional demo-account passwords for `manage.py seed_demo` (demo only) ---
# DEMO_ADMIN_PASSWORD=Admin@2026
# DEMO_PROFESSOR_PASSWORD=Prof@2026
# DEMO_STUDENT_PASSWORD=Student@2026

# --- AI Career Intelligence (optional — features degrade gracefully without it) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
