DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Uncomment to use PostgreSQL (see docker-compose.yml at repo root)
# DB_ENGINE=postgres
# DB_NAME=skillmap
# DB_USER=skillmap
# DB_PASSWORD=skillmap
# DB_HOST=localhost
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Password-reset email link points at the SPA
FRONTEND_URL=http://localhost:5173

# Optional demo-account passwords for `manage.py seed_demo` (demo only)
# DEMO_ADMIN_PASSWORD=Admin@2026
# DEMO_PROFESSOR_PASSWORD=Prof@2026
# DEMO_STUDENT_PASSWORD=Student@2026

# AI Career Intelligence (optional — features degrade gracefully without it)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini