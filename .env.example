# =========================================================
# SkillMap AI — environment variable reference
# Copy to backend/.env and frontend/.env as needed.
# =========================================================

# --- Django (backend/.env) ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — default is SQLite (zero config).
# For PostgreSQL via docker-compose, set:
DB_ENGINE=postgres
DB_NAME=skillmap
DB_USER=skillmap
DB_PASSWORD=skillmap
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1